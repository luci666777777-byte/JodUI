                                        end
                                        return nil
                                        end

                                        -- วาปไปจุดวาป (Boss01..05 / Town / Field..)
                                        local function LooksLikeWarpId(s)
                                        return type(s) == "string" and (s:match("^Boss%d+$") or s:match("^Field%d+$") or s == "Town")
                                        end

                                        local function FireWarp(remoteName, id)
                                        local L = Learned[remoteName]
                                        if L then
                                        local args = { n = L.args.n }
                                        local replaced = false
                                        for i = 1, L.args.n do
                                        local a = L.args[i]
                                        if not replaced and LooksLikeWarpId(a) then
                                        args[i] = id
                                        replaced = true
                                    else
                                        args[i] = a
                                        end
                                        end
                                        if replaced then
                                        return FireRaw(remoteName, table.unpack(args, 1, args.n))
                                        end
                                        end
                                        return FireRaw(remoteName, id)
                                        end

                                        local function NearPos(pos, radius)
                                        local r = Root()
                                        return r ~= nil and Dist(r.Position, pos) <= (radius or 150)
                                        end

                                        local function WarpTo(warpId, targetPos, cancelled)
                                        if targetPos and NearPos(targetPos, 150) then
                                        return true
                                        end
                                        -- 1) pillar prompt
                                        local pillars = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("WarpPillars")
                                        local pillar = pillars and pillars:FindFirstChild("WarpPillar_" .. warpId)
                                        if pillar then
                                        local prompt = FindPrompt(pillar, "WarpPrompt") or FindPrompt(pillar)
                                        if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
                                        Travel(prompt.Parent.Position + Vector3.new(0, 2, 0), cancelled)
                                        FirePrompt(prompt)
                                        task.wait(2.2)
                                        if not targetPos or NearPos(targetPos, 150) then
                                        return true
                                        end
                                        end
                                        end
                                        -- 2) remote
                                        for _, rn in ipairs({ "PillarWarp", "WarpTo" }) do
                                        FireWarp(rn, warpId)
                                        task.wait(2.2)
                                        if targetPos and NearPos(targetPos, 150) then
                                        return true
                                        end
                                        if cancelled and cancelled() then
                                        return false
                                        end
                                        end
                                        -- 3) บินไปเอง
                                        if targetPos then
                                        Travel(targetPos, cancelled)
                                        return NearPos(targetPos, 150)
                                        end
                                        return false
                                        end

                                        local function GoTown()
                                        if not WarpTo("Town", TOWN_POS) then
                                        Travel(TOWN_POS)
                                        end
                                        end

                                        ----------------------------------------------------------------
                                        -- ค้นหามอนสเตอร์ / บอส
