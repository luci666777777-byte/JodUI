                                Section(PBoss, "Auto Farm Boss (ออโต้ฟาร์มบอส)")

                                local bossRunning = false
                                local noBossSince = nil

                                local function AnyBossEnabled()
                                    for _, b in ipairs(BOSSES) do
                                        if Config[b.key] then
                                        return true
                                        end
                                    end
                                    return false
                                end

                                local BOSS_LV_KEY = {
                                    bigboss_tempest_dragon_king = "BossLvTempest", bigboss_obsidian_pharaoh = "BossLvPharaoh",
                                    bigboss_volcano_turtle_king = "BossLvTurtle", bigboss_thornback_behemoth = "BossLvBehemoth",
                                    terra_colossus = "BossLvColossus",
                                }
                                local lastLvNote = 0
                                local function BossLevelOK(b)
                                    if not Config.BossLevelGate then
                                        return true
                                    end
                                    local need = Config[BOSS_LV_KEY[b.id]] or 0
                                    local lvl = GetLevel()
                                    if not lvl then
                                        return true
                                    end
                                    if lvl >= need then
                                        return true
                                    end
                                    if tick() - lastLvNote > 30 then
                                        lastLvNote = tick()
                                        Notify(string.format("เลเวล %d ยังไม่ถึง %d สำหรับ %s → ฟาร์มมอนก่อน", lvl, need, b.name))
                                    end
                                    return false
                                end

                                local function BossStep()
                                    local cancelled = function()
                                        return not Config.BossFarm
                                    end
                                    local didSomething = false
                                    local levelBlocked = false
                                    for _, b in ipairs(BOSSES) do
                                        if cancelled() then
                                        return
                                        end
                                        if Config[b.key] and BossAliveFlag(b.id) and not BossLevelOK(b) then
                                        levelBlocked = true
                                    elseif Config[b.key] and BossAliveFlag(b.id) then
                                        local m = FindBossModel(b.id)
                                        if not m then
                                        -- ไปที่ห้องบอสเพื่อให้โหลดโมเดล
                                        Engage.last = 0
                                        Notify("วาปไป " .. b.name)
                                        WarpTo("Boss0" .. b.n, ArenaPos(b.n), cancelled)
                                        local t0 = tick()
                                        while not cancelled() and tick() - t0 < 7 do
                                        m = FindBossModel(b.id)
                                        if m then
                                        break
                                        end
                                        task.wait(0.4)
                                        end
                                        end
                                        if m then
                                        didSomething = true
                                        noBossSince = nil
                                        Notify("ตี " .. b.name)
                                        EngageTarget(m, function()
                                        return Config.BossFarm and Config[b.key]
                                        end, 25)
                                        break
                                        end
                                        end
                                    end
                                    if not didSomething then
                                        if not noBossSince or levelBlocked then
                                        noBossSince = tick()
                                        end
                                        -- ระหว่างรอบอส ฟาร์มมอนสเตอร์ธรรมดา
                                        if Config.BossMobWait and not cancelled() then
                                        local mob = NearestMonster(400, MobAllowed, Config.MobPreferHigh)
                                        or NearestMonster(math.huge, MobAllowed, false)
                                        if mob then
                                        local mr0, r0 = MRoot(mob), Root()
                                        if r0 and mr0 and Dist(r0.Position, mr0.Position) > 250 then
                                        Travel(mr0.Position + Vector3.new(0, 4, 0), cancelled)
                                        end
                                        EngageTarget(mob, function()
                                        return Config.BossFarm
                                        end, 10)
                                        return
                                        end
                                        end
                                        if Config.BossHop and AnyBossEnabled() and tick() - noBossSince > Config.BossHopWait then
                                        noBossSince = nil
                                        Notify("ไม่มีบอส → ย้ายเซิร์ฟ")
                                        if _G.__VEXORA_HOP then
                                        _G.__VEXORA_HOP()
                                        end
                                        end
                                        task.wait(1)
                                    end
                                end

