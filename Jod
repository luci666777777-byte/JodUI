                                        local ok = false
                                        pcall(function()
                                        prompt.HoldDuration = 0
                                        prompt.RequiresLineOfSight = false
                                        prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 20)
                                        end)
                                        if fireproximityprompt then
                                        ok = pcall(fireproximityprompt, prompt)
                                        end
                                        return ok
