                                Section(PTele, "Teleport / NPC Finder (วาปหา NPC)")

                                local function NpcCF(npcId)
                                    local npcs = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("NPCs")
                                    local model = npcs and npcs:FindFirstChild(npcId)
                                    local pos = NPCS[npcId]
                                    local look = Vector3.new(0, 0, 1)
                                    if model then
                                        local ok, cf = pcall(function()
                                        return model:GetPivot()
                                        end)
                                        if ok then
                                        pos = cf.Position
                                        look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
                                        if look.Magnitude < 0.1 then
                                        look = Vector3.new(0, 0, 1)
                                        end
                                        look = look.Unit
                                        end
                                    end
                                    if not pos then
                                        return nil
                                    end
                                    local stand = pos + look * 5
                                    return CFrame.lookAt(Vector3.new(stand.X, pos.Y, stand.Z), Vector3.new(pos.X, pos.Y, pos.Z)), model
                                end

