                                    pcall(function()
                                        local pr = Remotes and Remotes:FindFirstChild("MonsterProjectile")
                                        if pr then
                                        pr.OnClientEvent:Connect(function(...)
                                        if not Config.AutoDodge then
                                        return
                                        end
                                        local function scan(v, depth)
                                        local ty = typeof(v)
                                        if ty == "Vector3" then
                                        AddThreat(v, 10, 1.2)
                                    elseif ty == "CFrame" then
                                        AddThreat(v.Position, 10, 1.2)
                                    elseif ty == "Instance" and v:IsA("BasePart") then
                                        AddThreat(v.Position, math.max(8, math.max(v.Size.X, v.Size.Z) / 2 + 4), 1.2)
                                    elseif ty == "table" and depth < 2 then
                                        for _, x in pairs(v) do
                                        scan(x, depth + 1)
                                        end
                                        end
                                        end
                                        for i = 1, select("#", ...) do
                                        scan((select(i, ...)), 0)
                                        end
                                        end)
                                    end
                                end)

                                local function ScanFolder(name)
                                    local f = Workspace:FindFirstChild(name)
                                    if not f then
                                        return
                                    end
                                    local n = 0
                                    for _, d in ipairs(f:GetDescendants()) do
                                        if d:IsA("BasePart") and d.Transparency < 1 then
                                        local owner = d:GetAttribute("OwnerUserId") or d:GetAttribute("CasterUserId")
                                        if owner == nil then
                                        n = n + 1
                                        if n > 80 then
                                        break
                                        end
                                        local rad = math.max(d.Size.X, d.Size.Z) / 2
                                        if rad >= 3 then
