            sc = New("UIScale", { Scale = 1 }, btn)
            btn.MouseButton1Down:Connect(function()
                Tween(sc, 0.08, { Scale = 0.982 })
            end)
            btn.MouseButton1Up:Connect(function()
                Tween(sc, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
            end)
