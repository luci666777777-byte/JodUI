                            Section(PUp, "Auto Stat / Auto Upgrade (ตีบวก)")

                            local STATS = { "STR", "AGI", "VIT", "INT", "DEX", "LUK" }
                            local statRot = 0
                            local function StatNames(base)
                                return { base, string.upper(base), string.lower(base), base:sub(1, 1) .. string.lower(base:sub(2)) }
                            end
                            local function AllocOne(stat)
                                local L = Learned.AllocateStat
                                if L then
                                    local args = { n = L.args.n }
                                    local replaced = false
                                    for i = 1, L.args.n do
                                        local a = L.args[i]
                                        if not replaced and type(a) == "string" and (a:upper() == "STR" or a:upper() == "AGI" or a:upper() == "VIT"
                                        or a:upper() == "INT" or a:upper() == "DEX" or a:upper() == "LUK") then
                                        -- รักษารูปแบบตัวพิมพ์เดิมของเกม
                                        if a == a:upper() then
                                        args[i] = stat:upper()
                                    elseif a == a:lower() then
                                        args[i] = stat:lower()
                                    else
                                        args[i] = stat:sub(1, 1):upper() .. stat:sub(2):lower()
                                        end
                                        replaced = true
                                    else
                                        args[i] = a
                                        end
                                        end
                                        if replaced then
                                        for i = 1, args.n do
