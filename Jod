                            set(not state, true)
                        end)

                        Refreshers[#Refreshers + 1] = function()
                            state = Config[opts.key] == true
                            render(false)
                            if opts.callback then
                                task.spawn(opts.callback, state)
                            end
                        end

                        if opts.callback then
                            task.defer(opts.callback, state)
                        end

                        return {
                            Get = function()
                                return state
                            end,
                            Set = function(v)
                                set(v, true)
                            end,
                        }
