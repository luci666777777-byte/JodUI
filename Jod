                                local CDBackup = {}
                                local function WalkCD(t, depth, seen, restore)
                                    if depth > 5 or seen[t] then
                                        return
                                    end
                                    seen[t] = true
                                    for k, v in pairs(t) do
                                        if type(v) == "number" and type(k) == "string" then
                                        local lk = string.lower(k)
                                        if lk:find("cool") or lk == "cd" or lk:find("cdsec") or lk == "delay" then
                                        if restore then
                                        local b = CDBackup[t] and CDBackup[t][k]
                                        if b ~= nil then
                                        t[k] = b
                                        end
                                    else
                                        CDBackup[t] = CDBackup[t] or {}
                                        if CDBackup[t][k] == nil then
                                        CDBackup[t][k] = v
                                        end
                                        t[k] = 0
                                        end
                                        end
                                    elseif type(v) == "table" then
                                        WalkCD(v, depth + 1, seen, restore)
                                        end
                                        end
                                    end
                                    local CDLoop = MakeLoop("NoCD", 2, function()
                                        local shared = RS:FindFirstChild("Shared")
                                        local sd = shared and shared:FindFirstChild("SkillData")
                                        if sd then
                                        local mod = require(sd)
                                        if type(mod) == "table" then
                                        WalkCD(mod, 0, {}, false)
                                        end
                                        end
                                        for k, v in pairs(LocalPlayer:GetAttributes()) do
                                        if type(v) == "number" and string.lower(k):find("cool") then
                                        LocalPlayer:SetAttribute(k, 0)
