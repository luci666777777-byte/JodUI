                            ----------------------------------------------------------------
                            -- Remote layer: เรียนรู้ args จากที่เกมส่งจริง แล้วเล่นซ้ำ
                            ----------------------------------------------------------------
                            local Learned = {} -- name -> { args=packed, list={...}, keys={} }
                            local OwnCall = false

                            local function IsMonsterInst(a)
                                local mf = MonstersFolder()
                                return mf ~= nil and a ~= mf and a:IsDescendantOf(mf)
                            end

                            local function CopyArg(v)
                                if type(v) == "table" then
                                    local t = {}
                                    for k, x in pairs(v) do
                                        t[k] = CopyArg(x)
                                    end
                                    return t
                                end
                                return v
                            end

                            local function SigOf(args)
                                local parts = {}
                                for i = 1, args.n do
                                    local a = args[i]
                                    local ty = typeof(a)
                                    if ty == "Instance" then
                                        parts[#parts + 1] = IsMonsterInst(a) and "<T>" or ("I:" .. a.Name)
                                    elseif ty == "Vector3" or ty == "CFrame" then
                                        parts[#parts + 1] = "<P>"
                                    elseif ty == "table" then
                                        parts[#parts + 1] = "{...}"
                                    else
                                        parts[#parts + 1] = ty .. ":" .. tostring(a)
                                        end
                                        end
                                        return table.concat(parts, "|")
                                    end

                                    local function FmtArgs(args)
                                        local out = {}
                                        for i = 1, args.n do
                                        local a = args[i]
                                        if typeof(a) == "Instance" then
                                        out[#out + 1] = a:GetFullName()
                                    elseif type(a) == "table" then
                                        out[#out + 1] = "{table}"
                                    else
                                        out[#out + 1] = tostring(a)
                                        end
                                        end
                                        return table.concat(out, ", ")
                                        end

                                        local NOISY = { Dash = true, AttackAnimU = true, SitToggle = true, SetHudLayout = true, MapLife = true }

                                        local function Capture(remote, method, args)
                                        local name = remote.Name
                                        local copy = { n = args.n }
                                        for i = 1, args.n do
                                        copy[i] = CopyArg(args[i])
                                        end
                                        local L = Learned[name]
                                        if not L then
                                        L = { list = {}, keys = {}, count = 0 }
                                        Learned[name] = L
                                        end
                                        L.args = copy
                                        L.count = L.count + 1
                                        local sig = SigOf(copy)
                                        if not L.keys[sig] then
                                        L.keys[sig] = true
                                        L.list[#L.list + 1] = copy
                                        if #L.list > 14 then
                                        local old = table.remove(L.list, 1)
                                        L.keys[SigOf(old)] = nil
                                        end
                                        end
                                        if Config.RemoteLog and not NOISY[name] then
                                        print(string.format("[VEXORA][%s] %s(%s)", method, name, FmtArgs(copy)))
                                        end
                                        end

                                        local HookOK = false
                                        pcall(function()
                                        if not (hookmetamethod and getnamecallmethod) then
                                        return
                                        end
                                        local old
                                        local function hook(self, ...)
                                        local m = getnamecallmethod()
                                        if (m == "Kick" or m == "kick") and self == LocalPlayer and Config.AntiKick then
                                        return
                                        end
                                        if (m == "FireServer" or m == "InvokeServer") and not OwnCall and typeof(self) == "Instance" then
                                        if self.Parent == Remotes then
                                        local packed = table.pack(...)
                                        task.defer(Capture, self, m, packed)
                                        end
                                        end
                                        return old(self, ...)
                                        end
                                        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)
                                        HookOK = true
                                        end)

                                        local function FireRaw(name, ...)
                                        local r = Remotes and Remotes:FindFirstChild(name)
                                        if not r then
                                        return false
                                        end
                                        OwnCall = true
                                        local ok = pcall(function(...)
                                        if r:IsA("RemoteFunction") then
                                        task.spawn(function(...)
                                        pcall(r.InvokeServer, r, ...)
                                        end, ...)
                                    else
                                        r:FireServer(...)
                                        end
                                        end, ...)
                                        OwnCall = false
                                        return ok
                                        end

                                        -- เล่นซ้ำ args ที่เรียนรู้ โดยแทนที่เป้าหมาย (มอนสเตอร์) ด้วยเป้าหมายใหม่
                                        local function BuildArgs(src, target)
                                        local args = { n = src.n }
                                        for i = 1, src.n do
                                        local a = src[i]
                                        local ty = typeof(a)
                                        if target and ty == "Instance" and IsMonsterInst(a) then
                                        args[i] = target
                                    elseif target and ty == "Vector3" then
                                        local mr = MRoot(target)
                                        args[i] = mr and mr.Position or a
                                    elseif target and ty == "CFrame" then
                                        local mr = MRoot(target)
                                        args[i] = mr and mr.CFrame or a
                                    else
                                        args[i] = a
                                        end
                                        end
                                        return args
                                        end

                                        local function Replay(name, target, which)
                                        local L = Learned[name]
                                        if not L then
                                        return false
                                        end
                                        local src = which or L.args
                                        local args = BuildArgs(src, target)
                                        return FireRaw(name, table.unpack(args, 1, args.n))
                                        end

                                        local function HasLearned(name)
                                        return Learned[name] ~= nil
                                        end

                                        ----------------------------------------------------------------
                                        -- เคลื่อนที่ / วาป
                                        ----------------------------------------------------------------
                                        local function ZeroVel(r)
                                        r.AssemblyLinearVelocity = Vector3.zero
                                        r.AssemblyAngularVelocity = Vector3.zero
                                        end

                                        local function TP(cf)
                                        local r = Root()
                                        if r then
                                        r.CFrame = cf
                                        ZeroVel(r)
                                        end
                                        end

                                        -- เคลื่อนที่แบบก้าวต่อก้าว (ลดโอกาสถูกเซิร์ฟเวอร์ดึงกลับ)
                                        local function Travel(pos, cancelled)
                                        local speed = Config.TPSpeed
                                        if Config.SafeMode then
                                        speed = math.min(speed, 220)
                                        end
                                        local r = Root()
                                        if not r then
                                        return false
                                        end
                                        if speed >= 1000 then
                                        TP(CFrame.new(pos))
                                        return true
                                        end
                                        local guard = 0
                                        while guard < 4000 do
                                        guard = guard + 1
                                        r = Root()
                                        if not r or (cancelled and cancelled()) then
                                        return false
                                        end
                                        local d = Dist(r.Position, pos)
                                        if d <= 3 then
                                        return true
                                        end
                                        local dt = RunService.Heartbeat:Wait()
                                        local step = math.min(d, speed * dt)
                                        local dir = (pos - r.Position).Unit
                                        r.CFrame = CFrame.new(r.Position + dir * step)
                                        ZeroVel(r)
                                        end
                                        return false
                                        end

                                        local RayP = RaycastParams.new()
                                        RayP.FilterType = Enum.RaycastFilterType.Exclude
                                        local function GroundY(pos)
                                        local ex = {}
                                        local mf = MonstersFolder()
                                        if mf then
                                        ex[#ex + 1] = mf
                                        end
                                        for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                                        if p.Character then
                                        ex[#ex + 1] = p.Character
                                        end
                                        end
                                        RayP.FilterDescendantsInstances = ex
                                        local res = Workspace:Raycast(pos + Vector3.new(0, 40, 0), Vector3.new(0, -160, 0), RayP)
                                        return res and res.Position.Y or nil
                                        end

                                        local function FirePrompt(prompt)
                                        if not prompt then
