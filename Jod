                                    TP(cf)
                                    Notify("วาปไป " .. label)
                                    if Config.OpenNpcOnTP then
                                        task.wait(0.4)
                                        local pr = model and FindPrompt(model, "TalkPrompt")
                                        if pr then
                                        FirePrompt(pr)
                                    else
                                        FireRaw("OpenNpc", npcId)
                                        end
                                    end
                                end

