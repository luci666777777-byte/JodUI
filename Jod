                                        local Blacklist = setmetatable({}, { __mode = "k" })

                                        local function FindBossModel(id)
                                        local mf = MonstersFolder()
                                        if not mf then
                                        return nil
                                        end
                                        for _, m in ipairs(mf:GetChildren()) do
                                        if m:GetAttribute("MonsterId") == id and Alive(m) then
                                        return m
                                        end
                                        end
                                        return nil
                                        end

                                        local function BossAliveFlag(id)
                                        local v = Workspace:GetAttribute("BossAlive_" .. id)
                                        return v ~= false
                                        end

                                        local function IsAnyBoss(m)
                                        return m:GetAttribute("IsBoss") == true or m:GetAttribute("IsMiniBoss") == true
                                        end

                                        local function NearestMonster(maxDist, filter, prefer)
                                        local mf = MonstersFolder()
                                        local r = Root()
                                        if not (mf and r) then
                                        return nil
                                        end
                                        local best, bs, bd = nil, math.huge, math.huge
                                        local limit = maxDist or math.huge
                                        for _, m in ipairs(mf:GetChildren()) do
                                        if m:GetAttribute("IsDummy") ~= true and Alive(m) and not (Blacklist[m] and Blacklist[m] > tick()) then
                                        local mr = MRoot(m)
                                        if mr and (not filter or filter(m)) then
                                        local d = Dist(r.Position, mr.Position) - (m:GetAttribute("Radius") or 0)
                                        if d < limit then
                                        local score = d
                                        if prefer then
                                        score = d - (tonumber(m:GetAttribute("Level")) or 0) * 8
                                        end
                                        if score < bs then
                                        best, bs, bd = m, score, d
                                        end
                                        end
                                        end
                                        end
                                    end
                                    return best, bd
                                end

                                -- ตัวกรองมอนสเตอร์ (ชื่อ / เลเวล / Leader)
                                local SelStr, SelSet = nil, {}
                                local function Sel()
                                    if Config.MobSelect ~= SelStr then
                                        SelStr = Config.MobSelect
                                        SelSet = {}
                                        for n in string.gmatch(SelStr, "[^|]+") do
                                        SelSet[n] = true
                                        end
                                    end
                                    return SelSet
                                end
                                local function BaseName(m)
                                    local dn = m:GetAttribute("DisplayName") or m.Name
                                    return (string.gsub(dn, "^Leader ", ""))
                                end
                                local function MobAllowed(m, ignoreProgress)
                                    if m:GetAttribute("IsBoss") == true then
                                        return false
                                    end
                                    if m:GetAttribute("IsMiniBoss") == true and not Config.MobMini then
                                        return false
                                    end
                                    local leader = m:GetAttribute("IsLeader") == true
                                    if leader and not Config.MobLeaders then
                                        return false
                                    end
                                    if Config.MobLeaderOnly and not leader then
                                        return false
                                    end
                                    local hasSel = next(Sel()) ~= nil
                                    if hasSel and not Sel()[BaseName(m)] then
                                        return false
                                    end
                                    local ml = m:GetAttribute("Level")
                                    if type(ml) == "number" then
                                        if ml < Config.MobMinLv or ml > Config.MobMaxLv then
                                        return false
                                        end
                                        if not hasSel and not ignoreProgress then
                                        local lvl = GetLevel()
                                        if lvl and ml > lvl + Config.ProgressOver then
                                        return false
                                        end
                                        end
                                    end
                                    return true
                                end

