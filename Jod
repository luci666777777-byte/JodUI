                                    end
                                    local now = tick()
                                    local push = Vector3.zero
                                    local need = 0
                                    local live = {}
                                    for _, th in ipairs(Threats) do
                                        if th.t > now then
                                        live[#live + 1] = th
                                        local flat = Vector3.new(r.Position.X - th.pos.X, 0, r.Position.Z - th.pos.Z)
                                        local d = flat.Magnitude
                                        local lim = th.radius + 2
                                        if d < lim then
                                        local dir = d > 0.1 and flat.Unit or Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit
                                        push = push + dir * (lim - d + 1)
                                        need = math.max(need, lim - d)
