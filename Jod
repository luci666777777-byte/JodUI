                                local Dodge = { untilT = 0, pos = nil }
                                local Pose = { active = false, gy = nil, gyT = 0 }
                                local function ResetPose()
                                    if not Pose.active then
                                        return
                                    end
                                    Pose.active = false
                                    local h, r = Hum(), Root()
                                    if h then
                                        h.PlatformStand = false
                                    end
                                    if r then
                                        r.CFrame = CFrame.new(r.Position + Vector3.new(0, 1, 0))
                                        ZeroVel(r)
                                    end
                                end

                                local function StandNear(m, extra)
                                    local r, mr = Root(), MRoot(m)
                                    if not (r and mr) then
                                        return
                                    end
                                    local radius = m:GetAttribute("Radius") or 4
                                    if Dodge.untilT > tick() and Dodge.pos then
                                        -- กำลังหลบสกิล: ค้างตำแหน่งปลอดภัยไว้ก่อน
                                        if Config.HoverProne then
                                        local h = Hum()
                                        if h then
                                        h.PlatformStand = true
                                        end
                                        local dp = Dodge.pos
                                        local look = Vector3.new(mr.Position.X, dp.Y, mr.Position.Z)
                                        if (look - dp).Magnitude < 0.5 then
                                        look = dp + Vector3.new(0, 0, 1)
                                        end
                                        r.CFrame = CFrame.lookAt(dp, look) * CFrame.Angles(-math.pi / 2, 0, 0)
                                        Pose.active = true
                                    else
                                        r.CFrame = CFrame.new(Dodge.pos)
                                        end
                                        ZeroVel(r)
                                        return
                                    end
                                    if Config.HoverProne then
                                        -- ลอยเหนือพื้น + นอนคว่ำ
                                        local want = radius * 0.7 + 1
                                        local flat = Vector3.new(r.Position.X - mr.Position.X, 0, r.Position.Z - mr.Position.Z)
                                        local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
                                        local px = mr.Position + dir * want
                                        if tick() - Pose.gyT > 0.3 then
                                        Pose.gyT = tick()
                                        Pose.gy = GroundY(mr.Position)
                                        end
                                        local y = (Pose.gy or (mr.Position.Y - 2)) + Config.HoverH
                                        local pos = Vector3.new(px.X, y, px.Z)
                                        local look = Vector3.new(mr.Position.X, y, mr.Position.Z)
                                        local h = Hum()
                                        if h then
                                        h.PlatformStand = true
                                        end
                                        r.CFrame = CFrame.lookAt(pos, look) * CFrame.Angles(-math.pi / 2, 0, 0)
                                        ZeroVel(r)
                                        Pose.active = true
                                        return
                                    end
                                    local want = radius + (extra or Config.BossDist)
                                    local flat = Vector3.new(r.Position.X - mr.Position.X, 0, r.Position.Z - mr.Position.Z)
                                    local d = flat.Magnitude
                                    if d > want + 3 or d < want - 3 or math.abs(r.Position.Y - mr.Position.Y) > 25 then
                                        local dir = d > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
                                        local px = mr.Position + dir * want
                                        local gy = GroundY(Vector3.new(px.X, mr.Position.Y, px.Z))
                                        local y = gy and (gy + 3.2) or mr.Position.Y
                                        r.CFrame = CFrame.lookAt(Vector3.new(px.X, y, px.Z), Vector3.new(mr.Position.X, y, mr.Position.Z))
                                        ZeroVel(r)
                                    else
                                        r.CFrame = CFrame.lookAt(r.Position, Vector3.new(mr.Position.X, r.Position.Y, mr.Position.Z))
                                        ZeroVel(r)
                                    end
                                end

                                MakeLoop("PoseWatch", 0.3, function()
                                    if Pose.active and ((not Config.HoverProne) or tick() - Engage.last > 1.2) then
                                        ResetPose()
                                    end
                                end)(true)

                                -- สู้กับเป้าหมายจนตาย / หมดเวลา / ถูกปิดฟังก์ชัน
                                local function EngageTarget(m, stillOn, maxIdle)
                                    local lastHP = m:GetAttribute("HP")
                                    local lastChange = tick()
                                    local lastHit = 0
                                    while stillOn() and Alive(m) do
                                        local r, mr = Root(), MRoot(m)
                                        if not (r and mr) then
                                        break
                                        end
                                        StandNear(m)
                                        Engage.last = tick()
                                        if tick() - lastHit > 0.3 then
                                        lastHit = tick()
                                        SetTarget(m)
                                        BasicAttack(m)
                                        end
                                        local hp = m:GetAttribute("HP")
                                        if hp ~= lastHP then
                                        lastHP = hp
                                        lastChange = tick()
                                        end
                                        if tick() - lastChange > (maxIdle or 14) then
                                        Blacklist[m] = tick() + 45
                                        break
                                        end
                                        RunService.Heartbeat:Wait()
                                    end
                                end

